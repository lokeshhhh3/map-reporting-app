# ===========================================================================
# .env.example  --  COPY THIS FILE AND RENAME THE COPY TO  .env
# ===========================================================================
#
# HOW TO USE
#   1. Copy this file, and rename the copy to exactly:   .env
#      (nothing before the dot, nothing after "env")
#   2. Open .env and paste in the six values from your Firebase project.
#      Where to find them: Firebase console -> Project settings -> Your apps
#   3. Save, then restart the dev server (Ctrl+C, then "npm run dev").
#
# IMPORTANT
#   * The .env file is listed in .gitignore, so it never goes to GitHub.
#     That is correct - it is your private project configuration.
#   * Every name must start with VITE_ . Vite only passes variables to the
#     browser if they do. "FIREBASE_API_KEY" would be undefined.
#   * No quotes around the values, and no spaces around the = sign.
#
# If you have not set up Firebase yet, you can ignore this file completely.
# The app runs on demo data until these values are filled in.
# ===========================================================================

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ---------------------------------------------------------------------------
#  MODERATOR ID  (optional - the app works fine without it)
# ---------------------------------------------------------------------------
#  The app signs each browser in silently (no password, no login screen).
#  Put YOUR browser's id here and you - and only you - get the buttons that
#  change a report's status and delete other people's reports.
#
#  How to find your id:
#    1. Turn on anonymous sign-in: Firebase console -> Authentication ->
#       Sign-in method -> Anonymous -> Enable
#    2. Open the website and press F12 (the browser console)
#    3. Look for:  "🔥 Signed in anonymously. Your uid is: abc123..."
#    4. Copy that whole id to the right of the = sign below
#    5. Restart the dev server, and re-run the deploy for the live site
#
#  Leave it empty and nobody is a moderator.
VITE_ADMIN_UID=
